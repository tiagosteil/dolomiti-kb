# Copiar para .env na VM (chmod 600). O .env não entra no repositório.

# Senha do SYS: a imagem do ORDS só a usa para instalar ou atualizar o ORDS no
# banco. Pode sair do .env depois da instalação e voltar só nas atualizações.
ORACLE_PWD=<senha-do-sys>

# Senha do ORDS_PUBLIC_USER. Obrigatória desde o ORDS 26.2.3, e diferente da do SYS.
ORACLE_USER_PWD=<senha-do-ords-public-user>

# IP privado da VM banco. No dev, o IP privado da própria VM.
IP_BANCO=<ip-privado-da-vm-banco>
