# Copiar para .env na VM (chmod 600). O .env não entra no repositório.
# Senhas diferentes para SYS, APEX e ORDS (análise, §7).

# Senha do SYS e do SYSTEM, usada pela imagem na criação do banco
ORACLE_PWD=<senha-do-sys>

# IP privado desta VM: a 1521 só escuta nele
IP_PRIVADO=<ip-privado-da-vm-banco>

# IP privado da VM de aplicação, onde o nginx atende os nomes *.localhost.
# No dev, é o mesmo IP_PRIVADO.
IP_APLICACAO=<ip-privado-da-vm-de-aplicacao>
